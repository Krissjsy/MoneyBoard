# Copy into your local environment or use `dotnet user-secrets`.
# Replace SQLEXPRESS with the SQL Server instance name shown in SSMS.
ConnectionStrings__MoneyBoard=Server=localhost\SQLEXPRESS;Database=MoneyBoard;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true
Authentication__SigningKey=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
# Set a real HTTPS frontend URL in staging/production. Never use localhost in production.
Frontend__BaseUrl=https://moneyboard.example.com
# Configure an SMTP provider. For local development, use a local SMTP capture service.
Email__SmtpHost=127.0.0.1
Email__SmtpPort=1025
Email__EnableSsl=false
Email__From=MoneyBoard <no-reply@moneyboard.local>
# Optional SMTP credentials (keep actual values in user-secrets or environment variables).
Email__Username=
Email__Password=
